# Copy to keystore.properties (git-ignored) and fill in your own values.
# Keep the .jks file itself outside this repository - it is Sheaf's upload key, and Play App
# Signing holds the real app-signing key, so losing this one means a reset request, not a
# lost app. Never commit it.
storeFile=/absolute/path/to/sheaf-release.jks
storePassword=
keyAlias=sheaf
keyPassword=
