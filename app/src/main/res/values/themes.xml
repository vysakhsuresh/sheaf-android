<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The platform theme exists only to paint the window before Compose takes over. Keeping
      its background identical to SheafColors.Background is what stops the flash on a cold
      start; the real theme lives in ui/theme/Theme.kt.

      @color/window_background is a pair: values/colors.xml holds the light value and
      values-night/colors.xml the dark one, so the platform picks whichever matches the
      phone. What this cannot do is read Sheaf's own theme setting - the window is painted
      before any of this app's code runs, so there is nothing to ask. That makes the flash
      gone for SYSTEM, which is the default, and leaves it only for someone who has chosen
      DARK or LIGHT against what their phone is set to.
    -->
    <style name="Theme.Sheaf" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
    </style>
</resources>
