    <string name="engine_compress_negligible">%1$d%% மட்டுமே சிறியதானதால், அசல் கோப்பே வைக்கப்பட்டது.</string>
    <plurals name="engine_compress_detail">
        <item quantity="one">%1$d%% சிறியது - %2$d படம் மீண்டும் என்கோட் செய்யப்பட்டது</item>
