<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so every device that can install Sheaf supports adaptive icons and there is
  no need for rasterised mipmap-*dpi fallbacks. The 512px PNG the Play Console asks for is
  generated separately into store-assets/.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
