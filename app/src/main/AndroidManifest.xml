<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sheaf holds the same line Deja and Abhyas do: no INTERNET permission, so the process
      cannot open a socket and a document cannot leave the phone even if a dependency tried
      to send it. Anyone can verify it on the Play Store listing without trusting a policy
      document.

      On a PDF toolkit this is the entire product. Every competitor in this category -
      iLovePDF, Smallpdf, Adobe - uploads the file to a server to do the work. The documents
      people run through these apps are contracts, bank statements, medical reports, ID
      scans. Sheaf does the same work on the device, and the reason to believe that is this
      file rather than a promise.

      Libraries declare permissions of their own and the manifest merger unions them in, so
      the two entries below strip network access back out no matter what any current or
      future dependency asks for. Never "fix" a merger conflict by dropping these lines -
      check the result in app/build/outputs/logs/manifest-merger-*-report.txt after a build.

      Consequences that shape the code, and that are worth the trade:
        - No crash reporting. The Settings screen exports a crash log the user sends
          themselves; the app never sends anything.
        - No ML Kit Document Scanner in P2. It pulls its module through Play services. The
          scanner is built here instead.
        - OCR will use ML Kit's *bundled* recogniser, same as Deja and Abhyas.

      WAKE_LOCK is kept: WorkManager needs it to finish a long operation, and it grants no
      access to anything off the device.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
      Android 13+ notification permission. Declaring it turns nothing on. It is requested at
      runtime, once, right before the first job is submitted (ui/components/NotificationGate),
      because that is when a progress notification becomes useful and the one-line reason
      shown first makes sense. A refusal changes nothing about the work: the job still runs as
      a foreground service and its progress shows in the app.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      A long operation runs as a foreground service so Android does not kill a four-hundred-page
      job the moment the user switches app. From Android 14 every foreground service must
      declare a type and hold the matching permission, and WorkManager's setForeground() path
      is no exception - without these the first long job dies with
      MissingForegroundServiceTypeException. "dataSync" is the correct type: the work is
      processing the user's own files on the device.

      WorkManager declares WAKE_LOCK itself and it is deliberately not stripped: it is what
      lets a running job finish, and it grants no access to anything off the device.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Photographing a page is how the scanner gets documents in. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      No storage permission of any kind, and specifically never MANAGE_EXTERNAL_STORAGE.
      Every file comes in through the Storage Access Framework - the user picks it, the
      system grants access to that document alone, and exports go back out through
      ACTION_CREATE_DOCUMENT. That is both the correct privacy posture and the single
      biggest Play review trap in this category avoided.
    -->

    <!--
      enableOnBackInvokedCallback turns on predictive back from Android 13. Nothing in the app
      intercepts back itself - the only back behaviour is the navigation graph's, through
      OnBackPressedDispatcher, which androidx.activity forwards to the platform callback once this
      is set. So the flag is the whole change: the system gets to animate the gesture instead of
      waiting to find out whether the app will handle it.
    -->

    <!--
      Read aloud uses the phone's own text-to-speech engine, which runs on the device. On
      Android 11 and later an app cannot see another package's services unless it says which
      kind it wants, and without this line the engine is simply "not found".
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!--
          "Open in another reader": without this, Android 11+ hides every other PDF app from
          Sheaf and resolveActivity answers that there is none.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- Define and Translate on a selection in the viewer, handed to whatever app offers them. -->
        <intent>
            <action android:name="android.intent.action.DEFINE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TRANSLATE" />
        </intent>
    </queries>

    <application
        android:name=".SheafApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sheaf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Sheaf">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Being in the share sheet and the "open with" list is the distribution plan.
              With no marketing budget, appearing when someone long-presses a PDF is how
              people find this app, so these filters are a feature and not boilerplate.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!--
              Everything Sheaf can turn into a PDF, from the share sheet and "open with": a
              photo, a Word file, a spreadsheet, plain text. These land on Open a file rather
              than the viewer, which looks at what arrived and offers the tool that fits it -
              Images to PDF for photos, Office to PDF for the rest. Not BROWSABLE: a web page
              linking a .docx should open in the browser's own download, not jump here.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/markdown" />
            </intent-filter>

            <!--
              Launcher shortcuts arrive here. A static shortcut cannot carry an extra
              reliably, so the tool is named in the Uri path and MainActivity reads it. The
              scheme is the app's own and nothing outside the launcher sends it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sheaf" android:host="tool" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen widgets. Both only start MainActivity with intents it already handles. -->
        <receiver
            android:name=".widgets.QuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions" />
        </receiver>

        <receiver
            android:name=".widgets.RecentsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recents_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recents" />
        </receiver>

        <!-- Adds the type to the service WorkManager's own manifest contributes. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
